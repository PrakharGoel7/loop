diff --git a/src/store/StorePage.css b/src/store/StorePage.css
--- a/src/store/StorePage.css
+++ b/src/store/StorePage.css
@@ -139,4 +139,15 @@
 .mira-size-grid button { height: 48px; border: 1px solid #d7d0c5; background: transparent; color: var(--mira-ink); font-size: 12px; transition: background .2s, color .2s; }
 .mira-size-grid button:hover, .mira-size-grid button.selected { border-color: #2c2b28; background: #2c2b28; color: white; }
+.mira-size-guide { margin-top: 18px; border-top: 1px solid var(--mira-line); border-bottom: 1px solid var(--mira-line); }
+.mira-size-guide summary { display: flex; justify-content: space-between; align-items: center; cursor: pointer; list-style: none; padding: 16px 0; font-size: 12px; font-weight: 700; }
+.mira-size-guide summary::-webkit-details-marker { display: none; }
+.mira-size-guide details[open] summary span { transform: rotate(45deg); }
+.mira-size-guide p { margin: 0 0 14px; color: #777168; font-size: 12px; line-height: 1.6; }
+.mira-measurement-table-wrap { overflow-x: auto; padding-bottom: 16px; }
+.mira-measurement-table-wrap table { width: 100%; border-collapse: collapse; font-size: 12px; }
+.mira-measurement-table-wrap th, .mira-measurement-table-wrap td { padding: 9px 10px; border-top: 1px solid var(--mira-line); text-align: left; }
+.mira-measurement-table-wrap thead th { color: #938a80; font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
+.mira-measurement-table-wrap tbody th { width: 54px; font-weight: 700; }
+.mira-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
 .mira-add-row { display: flex; gap: 10px; margin-top: 30px; }
 .mira-quantity-control { height: 55px; min-width: 110px; display: inline-flex; align-items: center; justify-content: space-between; border: 1px solid #d7d0c5; }
