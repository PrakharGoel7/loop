# First local run: Tavus cannot import documents from localhost.
# Remove this after setting a publicly reachable LOOP_PUBLIC_ORIGIN.
LOOP_DISABLE_TAVUS_KNOWLEDGE=1
# LOOP_PUBLIC_ORIGIN=https://your-loop-app.example

# Tavus recording delivery. Copy these non-secret identifiers to an ignored .env
# only after the GCS bucket and Workload Identity Federation are configured.
LOOP_GCS_PROJECT_ID=your-gcp-project-id
LOOP_GCS_BUCKET=your-recording-bucket
LOOP_GCS_WORKLOAD_IDENTITY_PROVIDER=projects/123456789/locations/global/workloadIdentityPools/tavus-recording-pool/providers/tavus-worker
LOOP_GCS_SERVICE_ACCOUNT_EMAIL=tavus-recording-writer@your-gcp-project-id.iam.gserviceaccount.com

# Live planner and coder use the authenticated local Codex CLI.
# LOOP_CODEX_BIN=/absolute/path/to/codex
LOOP_WORKER_MODEL=gpt-5.6-luna

# Optional warm remote execution (both required; SSH alias must already work).
# LOOP_WORKER_SSH_HOST=loop-worker
# LOOP_WORKER_REMOTE_ROOT=/opt/loop-worker
# LOOP_WORKER_REMOTE_CODEX_BIN=codex
